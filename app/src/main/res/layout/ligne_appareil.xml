<?xml version="1.0" encoding="utf-8"?>
<!-- Tuile appareil tactile. Le fond et les couleurs sont posés par le code
     (fond_appareil_on / fond_appareil_off) selon l'état. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/icone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_texte"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail"
            style="@style/StyleMesure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/etat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/pf_texte_faible"
        android:textSize="13sp" />

    <View
        android:id="@+id/point"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/pastille"
        android:backgroundTint="@color/pf_inactif" />

</LinearLayout>
