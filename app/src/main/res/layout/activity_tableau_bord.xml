<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pf_fond"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="18dp">

    <!-- Titre de l'écran -->
    <TextView
        style="@style/StyleTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tableau_de_bord"
        android:textSize="24sp" />

    <!-- État de la liaison : lisible en un coup d'œil -->
    <TextView
        style="@style/StyleSurtitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/etat_liaison" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/pastille"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:background="@drawable/pastille"
            android:backgroundTint="@color/pf_inactif" />

        <TextView
            android:id="@+id/etatTexte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/pf_texte"
            android:textStyle="bold"
            android:textSize="26sp"
            android:letterSpacing="-0.01" />
    </LinearLayout>

    <!-- Bouton de connexion -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/boutonConnexion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/se_connecter"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:backgroundTint="@color/pf_courant"
        app:cornerRadius="26dp"
        app:icon="@android:drawable/stat_sys_data_bluetooth"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="@color/pf_bord" />

    <!-- Appareils -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/StyleSurtitre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/appareils" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/boutonAjouter"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/ajouter_symbole"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        style="@style/StyleMesure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/astuce_appui_long"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/conteneurAppareils"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Journal horodaté -->
    <TextView
        style="@style/StyleSurtitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/journal_titre" />

    <ScrollView
        android:id="@+id/journalScroll"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@drawable/fond_journal"
        android:padding="14dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/journal"
            style="@style/StyleMesure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pf_texte_faible"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

</LinearLayout>
