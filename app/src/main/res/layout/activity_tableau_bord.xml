<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pf_fond">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Page Appareils : dédiée à la grille de tuiles de contrôle -->
        <LinearLayout
            android:id="@+id/pageAppareils"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/StyleSurtitre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/appareils" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boutonAjouter"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/ajouter_symbole"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/StyleMesure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="@string/astuce_appui_long"
                android:textSize="11sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/conteneurAppareils"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Page Connexion : état de la liaison, bouton et journal -->
        <LinearLayout
            android:id="@+id/pageConnexion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <TextView
                style="@style/StyleSurtitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etat_liaison" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/pastille"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:background="@drawable/pastille"
                    android:backgroundTint="@color/pf_inactif" />

                <TextView
                    android:id="@+id/etatTexte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/pf_texte"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boutonConnexion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/se_connecter"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="@color/pf_courant"
                app:cornerRadius="26dp"
                app:icon="@android:drawable/stat_sys_data_bluetooth"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="@color/pf_bord" />

            <TextView
                style="@style/StyleSurtitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/journal_titre" />

            <ScrollView
                android:id="@+id/journalScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                android:background="@drawable/fond_journal"
                android:padding="14dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/journal"
                    style="@style/StyleMesure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pf_texte_faible"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Page Historique : temps de fonctionnement et seuil d'alerte -->
        <LinearLayout
            android:id="@+id/pageHistorique"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp">

            <TextView
                style="@style/StyleSurtitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onglet_historique" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/StyleMesure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:text="@string/seuil_alerte_label" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:hint="@string/seuil_alerte_unite">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/champSeuilAlerte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/pf_bord" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/StyleSurtitre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/historique_liste_titre" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boutonReinitialiserHistorique"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/historique_reinitialiser"
                    android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/conteneurHistorique"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/navigation_bas" />

</LinearLayout>
