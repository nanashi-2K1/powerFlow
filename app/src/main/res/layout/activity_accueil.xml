<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/pf_fond"
    android:paddingHorizontal="32dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/titre"
        style="@style/StyleTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textSize="34sp" />

    <View
        android:layout_width="56dp"
        android:layout_height="2dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/rail"
        android:backgroundTint="@color/pf_courant" />

    <TextView
        android:id="@+id/sousTitre"
        style="@style/StyleMesure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/slogan"
        android:textColor="@color/pf_courant"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/accroche"
        android:textColor="@color/pf_texte_faible"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boutonCommencer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="40dp"
        android:text="@string/commencer"
        android:textColor="@color/pf_fond"
        android:textSize="15sp"
        android:letterSpacing="0.08"
        android:textStyle="bold"
        app:backgroundTint="@color/pf_courant"
        app:cornerRadius="14dp"
        />

</LinearLayout>
