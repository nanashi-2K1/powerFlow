<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PowerFlow" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/pf_courant</item>
        <item name="colorPrimaryVariant">@color/pf_courant_sombre</item>
        <item name="colorOnPrimary">@color/pf_fond</item>
        <item name="colorSecondary">@color/pf_courant</item>
        <item name="colorSecondaryVariant">@color/pf_courant_sombre</item>
        <item name="colorOnSecondary">@color/pf_fond</item>
        <item name="colorSurface">@color/pf_panneau</item>
        <item name="colorOnSurface">@color/pf_texte</item>
        <item name="android:colorBackground">@color/pf_fond</item>
        <item name="android:textColorPrimary">@color/pf_texte</item>
        <item name="android:statusBarColor">@color/pf_fond</item>
        <item name="android:navigationBarColor">@color/pf_fond</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="StyleTitre">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pf_texte</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="StyleMesure">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/pf_texte_faible</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>
